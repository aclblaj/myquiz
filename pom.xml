<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.0.0</version>
		<relativePath/>
	</parent>
	<groupId>com.unitbv.myquiz</groupId>
	<artifactId>myquiz-parent</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>myquiz-parent</name>
	<description>MyQuiz parent project for Spring Boot</description>

	<modules>
		<module>myquiz-api</module>
		<module>myquiz-app</module>
		<module>myquiz-thymeleaf</module>
        <module>myquiz-auth</module>
        <module>myquiz-iam</module>
	</modules>

	<properties>
		<project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
		<project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
		<java.version>21</java.version>
		<spring-boot.version>4.0.0</spring-boot.version>
		<lombok.version>1.18.40</lombok.version>
		<mapstruct.version>1.6.3</mapstruct.version>
		<maven.compiler.source>${java.version}</maven.compiler.source>
		<maven.compiler.target>${java.version}</maven.compiler.target>
		<maven-compiler-plugin>3.12.1</maven-compiler-plugin>
		<jackson-annotations.version>2.20</jackson-annotations.version>
		<spring-web.version>6.2.12</spring-web.version>
		<springdoc-openapi-starter-webmvc-ui.version>2.8.13</springdoc-openapi-starter-webmvc-ui.version>
		<!-- Additional library versions for consistency -->
		<poi.version>5.4.1</poi.version>
		<h2.version>2.4.240</h2.version>
		<postgresql.version>42.7.8</postgresql.version>
		<flying-saucer.version>10.0.3</flying-saucer.version>
		<commons-lang3.version>3.19.0</commons-lang3.version>
		<commons-io.version>2.20.0</commons-io.version>
		<jjwt.version>0.12.6</jjwt.version>
		<httpclient5.version>5.4</httpclient5.version>
		<hibernate-validator.version>8.0.1.Final</hibernate-validator.version>
		<jakarta-el.version>4.0.2</jakarta-el.version>
		<pdfbox.version>2.0.29</pdfbox.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-dependencies</artifactId>
				<version>${spring-boot.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<plugin>
					<groupId>org.springframework.boot</groupId>
					<artifactId>spring-boot-maven-plugin</artifactId>
				</plugin>
				<plugin>
					<groupId>org.apache.maven.plugins</groupId>
					<artifactId>maven-compiler-plugin</artifactId>
					<version>${maven-compiler-plugin}</version>
				</plugin>
			</plugins>
		</pluginManagement>
	</build>
</project>
